<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de extraccion de datos para Android 12+ (API 31+).
    Excluye la base de datos del historial y preferencias del backup en la nube
    y de transferencias entre dispositivos, para proteger datos del usuario.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Excluir la base de datos de Room (historial de escaneos/NFC) -->
        <exclude domain="database" path="app_database"/>
        <exclude domain="database" path="app_database-shm"/>
        <exclude domain="database" path="app_database-wal"/>
        <!-- Excluir preferencias de la app -->
        <exclude domain="sharedpref" path="app_settings.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Excluir historial en transferencias dispositivo-a-dispositivo -->
        <exclude domain="database" path="app_database"/>
        <exclude domain="database" path="app_database-shm"/>
        <exclude domain="database" path="app_database-wal"/>
    </device-transfer>
</data-extraction-rules>
