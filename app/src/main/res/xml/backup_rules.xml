<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de backup para Android 11 y anteriores (API <= 30).
    Excluye la base de datos del historial y preferencias del Auto Backup.
-->
<full-backup-content>
    <!-- Excluir base de datos Room del historial -->
    <exclude domain="database" path="app_database"/>
    <exclude domain="database" path="app_database-shm"/>
    <exclude domain="database" path="app_database-wal"/>
    <!-- Excluir preferencias -->
    <exclude domain="sharedpref" path="app_settings.xml"/>
</full-backup-content>
